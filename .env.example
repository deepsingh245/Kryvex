# See docs/DEVELOPMENT.md §5 for the full explanation of this split.

# ── PUBLIC CONFIG (safe in the client bundle) ──
# Firebase web config is not itself a secret; the real security boundary is
# Firestore/Storage rules + authentication (see docs/FIREBASE_SECURITY.md).

# apps/web (Next.js only inlines NEXT_PUBLIC_-prefixed vars)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-kryvex
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=localhost

# apps/mobile (Expo only inlines EXPO_PUBLIC_-prefixed vars)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-kryvex
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=true
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=localhost

# ── SECRET CONFIG (server-only; never referenced from client bundles) ──
# Used only by Cloud Functions / CI tooling, never shipped to apps/web or apps/mobile.
FIREBASE_SERVICE_ACCOUNT_JSON=
