{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // Explicit, not relying on automatic @types discovery: under pnpm's
    // per-package node_modules layout, TS's upward @types/ scan doesn't
    // reliably pick up @types/node even when it's a direct devDependency
    // (observed with typescript@6.0.3) — every package here runs in a
    // Node context, so this must be listed rather than assumed.
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // tsup's --dts bundling (rollup-plugin-dts) internally injects a
    // `baseUrl` for its own path resolution when it re-invokes the TS
    // compiler API; typescript@6.0.3 now hard-errors on `baseUrl` as
    // deprecated ahead of its TS 7.0 removal. Not something this repo's
    // config sets itself — suppressing per TS's own documented escape
    // hatch until tsup ships a fix.
    "ignoreDeprecations": "6.0"
  }
}
